{
  // Worker "gravel": Mulch-, Kies- und Erde-Rechner (USA)
  "name": "gravel",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Erzeugt public/ aus data/ und static/ (läuft vor jedem Deploy)
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Worker zuerst: www-Umleitung und noindex auf *.workers.dev
    "run_worker_first": true
  },
  // Eigene Domain (Zone im selben Cloudflare-Konto). www leitet der Worker auf die Hauptdomain um.
  "routes": [
    { "pattern": "gravelandmulch.com", "custom_domain": true },
    { "pattern": "www.gravelandmulch.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
