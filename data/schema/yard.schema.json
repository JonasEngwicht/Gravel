{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravelandmulch.com/schema/yard.schema.json",
  "title": "Landscape supply yard",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "status",
    "address",
    "location",
    "materials",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id, e.g. co-denver-example-landscape-supply"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "closed",
        "unverified"
      ]
    },
    "kind": {
      "enum": [
        "landscape-supply",
        "mulch-soil",
        "sand-gravel",
        "stone-yard",
        "quarry"
      ],
      "description": "Type of yard: landscape-supply (full-range yard), mulch-soil (mulch/topsoil yard), sand-gravel (sand & gravel pit or dealer), stone-yard (stone/rock yard), quarry (aggregate producer, mostly contractor sales)"
    },
    "chain": {
      "type": "string",
      "description": "Chain key for multi-location companies, e.g. 'siteone'"
    },
    "address": {
      "type": "object",
      "required": [
        "city",
        "state",
        "zip"
      ],
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "zip": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Only for quote forwarding, never shown publicly"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Material id from data/materials.json"
          },
          "bulk": {
            "type": "boolean",
            "default": true
          },
          "bagged": {
            "type": "boolean",
            "default": false
          },
          "price": {
            "type": "object",
            "required": [
              "amount",
              "unit",
              "updated"
            ],
            "properties": {
              "amount": {
                "type": "number"
              },
              "amount_max": {
                "type": "number",
                "description": "Upper end when the yard lists a price range (e.g. by color or grade); amount is the lower end"
              },
              "unit": {
                "enum": [
                  "cy",
                  "ton",
                  "bag"
                ]
              },
              "updated": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "enum": [
                  "yard-website",
                  "yard-submitted",
                  "phone",
                  "user-report"
                ]
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "radius_mi": {
          "type": "number"
        },
        "fee_from": {
          "type": "number"
        },
        "min_order_cy": {
          "type": "number"
        }
      }
    },
    "self_load": {
      "type": "boolean",
      "description": "Customers can pick up with their own truck/trailer"
    },
    "customers": {
      "type": "array",
      "items": {
        "enum": [
          "homeowner",
          "contractor"
        ]
      }
    },
    "hours": {
      "type": "object",
      "description": "Opening hours per weekday, e.g. { \"mon\": \"07:00-17:00\" }",
      "additionalProperties": {
        "type": "string"
      }
    },
    "seasonal": {
      "type": "string",
      "description": "e.g. 'Closed Dec–Feb'"
    },
    "listing": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "free",
            "featured"
          ],
          "default": "free"
        },
        "claimed": {
          "type": "boolean",
          "default": false
        },
        "accepts_quotes": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "checked"
      ],
      "properties": {
        "type": {
          "enum": [
            "own-research",
            "yard-website",
            "self-submitted",
            "public-list"
          ]
        },
        "url": {
          "type": "string"
        },
        "url_prices": {
          "type": "string",
          "description": "Exact URL of the yard's page that shows the prices"
        },
        "checked": {
          "type": "string",
          "format": "date"
        },
        "dataset": {
          "type": "string",
          "description": "Source dataset and release, e.g. overture-places-2026-11-18.0"
        },
        "ref": {
          "type": "string",
          "description": "Record id in the source dataset (Overture GERS id)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Source confidence score"
        },
        "merged_records": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of source records merged into this entry"
        }
      }
    },
    "msha": {
      "type": "array",
      "description": "Linked MSHA mines (Mine Safety and Health Administration, Mines data set). match: source = entry created from this mine; active-nearby = active mine of this business nearby; inactive-nearby = only an abandoned/idle mine nearby, check if the yard still operates.",
      "items": {
        "type": "object",
        "required": [
          "mine_id",
          "status",
          "match"
        ],
        "properties": {
          "mine_id": {
            "type": "string",
            "pattern": "^[0-9]{7}$"
          },
          "name": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Active",
              "Intermittent",
              "New Mine",
              "Temporarily Idled",
              "NonProducing",
              "Abandoned",
              "Abandoned and Sealed"
            ]
          },
          "status_since": {
            "type": "string",
            "format": "date"
          },
          "commodity": {
            "type": "string"
          },
          "employees": {
            "type": "integer",
            "minimum": 0
          },
          "match": {
            "enum": [
              "source",
              "active-nearby",
              "inactive-nearby"
            ]
          }
        }
      }
    }
  }
}
