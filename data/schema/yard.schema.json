{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravelandmulch.com/schema/yard.schema.json",
  "title": "Landscape supply yard",
  "type": "object",
  "required": ["id", "slug", "name", "status", "address", "location", "materials", "source"],
  "properties": {
    "id": { "type": "string", "description": "Stable id, e.g. co-denver-example-landscape-supply" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "status": { "enum": ["active", "closed", "unverified"] },
    "address": {
      "type": "object",
      "required": ["city", "state", "zip"],
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "zip": { "type": "string", "pattern": "^[0-9]{5}$" }
      }
    },
    "location": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } }
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email", "description": "Only for quote forwarding, never shown publicly" }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Material id from data/materials.json" },
          "bulk": { "type": "boolean", "default": true },
          "bagged": { "type": "boolean", "default": false },
          "price": {
            "type": "object",
            "required": ["amount", "unit", "updated"],
            "properties": {
              "amount": { "type": "number" },
              "unit": { "enum": ["cy", "ton", "bag"] },
              "updated": { "type": "string", "format": "date" },
              "source": { "enum": ["yard-website", "yard-submitted", "phone", "user-report"] }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "radius_mi": { "type": "number" },
        "fee_from": { "type": "number" },
        "min_order_cy": { "type": "number" }
      }
    },
    "self_load": { "type": "boolean", "description": "Customers can pick up with their own truck/trailer" },
    "customers": {
      "type": "array",
      "items": { "enum": ["homeowner", "contractor"] }
    },
    "hours": {
      "type": "object",
      "description": "Opening hours per weekday, e.g. { \"mon\": \"07:00-17:00\" }",
      "additionalProperties": { "type": "string" }
    },
    "seasonal": { "type": "string", "description": "e.g. 'Closed Dec–Feb'" },
    "listing": {
      "type": "object",
      "properties": {
        "tier": { "enum": ["free", "featured"], "default": "free" },
        "claimed": { "type": "boolean", "default": false },
        "accepts_quotes": { "type": "boolean", "default": false }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "checked"],
      "properties": {
        "type": { "enum": ["own-research", "yard-website", "self-submitted", "public-list"] },
        "url": { "type": "string" },
        "checked": { "type": "string", "format": "date" }
      }
    }
  }
}
